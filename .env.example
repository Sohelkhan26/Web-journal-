# Chronicle Journal - Environment Variables Example
# Copy this file to .env or configure in Cloudflare Dashboard > Pages > Settings > Environment Variables

# --- Security & Abuse Prevention ---
# Optional secret passkey required to access edge sync /api/sync.
# If set, incoming sync requests must provide this value via "Authorization: Bearer <SYNC_SECRET>" or "X-Sync-Key".
SYNC_SECRET=your-secure-random-passkey-here

# Maximum allowable sync requests per minute per IP before returning 429 Too Many Requests (default: 60)
RATE_LIMIT_PER_MINUTE=60

# --- Cloudflare D1 Database Binding (Optional Cloud Sync) ---
# Created via: npx wrangler d1 create journal_db
# Paste your generated UUID into wrangler.jsonc or bind via Cloudflare Pages Dashboard
D1_DATABASE_ID=your-d1-database-uuid-here
